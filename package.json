{
  "name": "sudoku",
  "description": "A Sudoku game built with React and Vite",
  "author": "Juan Castrillon <jfcastrillonr@gmail.com>",
  "version": "1.2.2",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "homepage": "https://jufecara.github.io/sudoku",
  "keywords": [
    "sudoku",
    "game",
    "react",
    "vite",
    "pwa"
  ],
  "scripts": {
    "audit:socket": "node scripts/socket-audit.mjs",
    "audit:dates": "node scripts/check-pkg-dates.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "coverage": "vitest run --coverage",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint . --max-warnings=0",
    "preview": "vite preview",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "validate": "yarn typecheck && yarn lint && yarn format:check && yarn test run && yarn npm audit --all --severity high && yarn audit:socket",
    "prepare": "husky"
  },
  "dependencies": {
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@socketsecurity/cli": "^1.1.102",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.8",
    "@vitest/ui": "4.1.8",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jsdom": "26.1.0",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.4",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.8"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,html,css}": [
      "prettier --write"
    ]
  },
  "packageManager": "yarn@4.16.0+sha512.5374c94eb4ef6aa8188fb112f20c1aa6569f248d676c5e576e1fd2a1a4d8d87a96df65d9dfe1c2a0252cbe38bda46cf18d955005b81b43cc7607a5c9d56fd2b6",
  "repository": {
    "type": "git",
    "url": "https://github.com/jufecara/sudoku"
  },
  "bugs": {
    "url": "https://github.com/jufecara/sudoku/issues"
  },
  "sideEffects": false
}
