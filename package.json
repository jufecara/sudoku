{
  "name": "sudoku",
  "description": "A Sudoku game built with React and Vite",
  "version": "1.2.4",
  "type": "module",
  "author": {
    "name": "Juan Castrillon",
    "email": "jfcastrillonr@gmail.com",
    "url": "https://github.com/jufecara"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jufecara/sudoku"
  },
  "bugs": {
    "url": "https://github.com/jufecara/sudoku/issues"
  },
  "homepage": "https://jufecara.github.io/sudoku",
  "keywords": [
    "sudoku",
    "game",
    "react",
    "vite",
    "pwa"
  ],
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "coverage": "vitest run --coverage",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "audit": "npm audit --audit-level=high",
    "lint": "eslint . --max-warnings=0",
    "preview": "vite preview",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "dependencies": {
    "lucide-react": "^1.27.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "overrides": {
    "brace-expansion": "5.0.8",
    "fast-uri": "3.1.4",
    "postcss": "8.5.23",
    "glob": "13.0.6",
    "source-map": "0.7.6",
    "whatwg-encoding": "3.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@socketsecurity/cli": "^1.1.102",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.8",
    "@vitest/ui": "4.1.10",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jsdom": "29.1.1",
    "lint-staged": "17.2.0",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.8"
  }
}
